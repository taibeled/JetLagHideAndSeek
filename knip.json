{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "tags": ["-lintignore"],
    "entry": [
        "src/lib/sw-register.ts",
        "src/pages/**/*.astro",
        "src/layouts/**/*.astro"
    ],
    "ignoreDependencies": [
        "@astrojs/check",
        "@react-leaflet/core",
        // @typescript-eslint/parser must stay as a direct devDep: eslint-plugin-astro
        // uses it as a peer dep and pnpm does not hoist peers automatically.
        "@typescript-eslint/parser"
    ],
    "ignoreIssues": {
        "src/lib/**": ["types"],
        "src/components/ui/**": ["types"],
        "src/maps/**": ["types"]
    }
}
